# API
NODE_ENV=production
NUXT_HOST=0.0.0.0
NUXT_PORT=3000

# URL del backend alcanzable desde DENTRO del contenedor del frontend
# (server-side / SSR). Si el frontend y el backend comparten la red Docker
# "innova" (ver deploy/docker-compose.yml de ambos repos), usa el nombre de
# servicio del backend, no localhost ni una IP.
SERVER_API_BASE=http://backend:8080/api/v1

# URL del backend alcanzable desde el NAVEGADOR del usuario final. Tiene que
# ser la IP o el dominio público del servidor — nunca localhost, nunca el
# nombre de servicio de Docker.
API_BASE=http://TU_SERVIDOR:8080/api/v1

# No usada activamente hoy (nada del código hace fetch a una ruta relativa
# /api/... que dependa de esto); se deja declarada por si se usa a futuro.
BACKEND_URL=

# Opcional: ID de Microsoft Clarity. Vacío = analítica deshabilitada.
NUXT_PUBLIC_CLARITY_ID=
