# Frontend - Nuxt Dev (Hot Reload)
FROM node:20-alpine

WORKDIR /app

# Install pnpm globally
RUN npm install -g pnpm

# Copy package files
COPY package.json pnpm-lock.yaml* ./
RUN pnpm install

# Copy source
COPY . .

# Expose port
EXPOSE 3000

# Dev mode with hot reload
CMD ["pnpm", "dev", "--host", "0.0.0.0"]